# Salin file ini menjadi ".env" lalu isi nilainya.
# Cara termudah: jalankan  node scripts/atur-admin.mjs  (akan mengisi .env otomatis).

# Email pengelola yang boleh masuk ke /admin
ADMIN_EMAIL=

# Hash kata sandi pengelola (format scrypt:salt:hash) — JANGAN isi sandi asli di sini.
# Buat dengan: node scripts/atur-admin.mjs
ADMIN_PASSWORD_HASH=

# Kunci rahasia untuk menandatangani sesi login (minimal 32 karakter acak).
AUTH_SECRET=

# Koneksi database (opsional; tanpa ini aplikasi memakai data JSON di folder public)
DATABASE_URL=
